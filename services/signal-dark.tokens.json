{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "bg":             { "$type": "color", "$value": "#0c0e12" },
    "surface":        { "$type": "color", "$value": "#14171d" },
    "surface-raised": { "$type": "color", "$value": "#191d26" },
    "fg":             { "$type": "color", "$value": "#e6e9ef" },
    "muted":          { "$type": "color", "$value": "#6b7280",
                        "$description": "non-text chrome only — 3.7-4.0:1 on bg" },
    "muted-text":     { "$type": "color", "$value": "#8b93a1",
                        "$description": "readable secondary text, 5.8:1 on surface" },
    "accent":         { "$type": "color", "$value": "#4ade80" },
    "accent-dim":     { "$type": "color", "$value": "#22472f" },
    "accent-text":    { "$type": "color", "$value": "#1a3a27" },
    "danger":         { "$type": "color", "$value": "#f87171" },
    "warning":        { "$type": "color", "$value": "#fbbf24" },
    "border":         { "$type": "color", "$value": "#232833" },
    "fill": {
      "hover":  { "$type": "color", "$value": "rgba(230,233,239,0.07)" },
      "active": { "$type": "color", "$value": "rgba(230,233,239,0.11)" },
      "accent": { "$type": "color", "$value": "rgba(74,222,128,0.14)" }
    }
  },
  "typography": {
    "font-display": { "$type": "fontFamily", "$value": "Inter, system-ui" },
    "font-body":    { "$type": "fontFamily", "$value": "Inter, system-ui" },
    "font-mono":    { "$type": "fontFamily", "$value": "JetBrains Mono, monospace" },
    "size": {
      "xs":   { "$type": "dimension", "$value": "12px" },
      "sm":   { "$type": "dimension", "$value": "13px" },
      "base": { "$type": "dimension", "$value": "13px" },
      "lg":   { "$type": "dimension", "$value": "16px" },
      "xl":   { "$type": "dimension", "$value": "20px" }
    }
  },
  "spacing": {
    "unit": { "$type": "dimension", "$value": "4px" },
    "xs":   { "$type": "dimension", "$value": "4px" },
    "sm":   { "$type": "dimension", "$value": "8px" },
    "md":   { "$type": "dimension", "$value": "12px" },
    "lg":   { "$type": "dimension", "$value": "16px" },
    "xl":   { "$type": "dimension", "$value": "20px" }
  },
  "radius": {
    "none":    { "$type": "dimension", "$value": "0px" },
    "control": { "$type": "dimension", "$value": "4px" },
    "window":  { "$type": "dimension", "$value": "8px" },
    "dock":    { "$type": "dimension", "$value": "12px" }
  },
  "shadow": {
    "hairline": { "$type": "shadow",
                  "$value": { "offsetX": "0px", "offsetY": "0px",
                              "blur": "0px", "spread": "0px",
                              "color": "rgba(0,0,0,0)" } },
    "popup":    { "$type": "shadow",
                  "$value": { "offsetX": "0px", "offsetY": "16px",
                              "blur": "40px", "spread": "0px",
                              "color": "rgba(0,0,0,0.55)" } }
  }
}
